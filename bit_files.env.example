# EXAMPLE - this file is a template, not live configuration.
# Copy it:   cp bit_files.env.example bit_files.env
# Your copy is gitignored, so pulls never overwrite it.
# Bit file paths - defined once, referenced by symbol in slot_map.md
# Source from scripts:  . ./bit_files.env
A=./firmwares/ddr4_selftest/top.bit
B=./firmwares/WR/top.bit
C=./firmwares/WAVEFORM-128/AMC_PPS_TRIGGER/FECtop.bit
D=./firmwares/WAVEFORM-128/AMC_EXTERNAL_TRIGGER/FECtop.bit
E=./firmwares/WAVEFORM-128/RTM/RTMtop.bit

# Optional: pin the Vivado used by program_fpgas.sh.
# Precedence: --vivado > $VIVADO > this entry > PATH > newest install found.
# VIVADO=/opt/Xilinx/Vivado/2022.2/bin/vivado

# Optional: MCH address used for JTAG channel selection.
# 192.168.1.41 is the NAT factory default and the scripts' built-in default,
# so this line can stay commented unless your shelf uses another address.
# Precedence: --mch > this entry > built-in default.
# MCH=192.168.1.41
